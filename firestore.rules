// ============================================================
// CALVIER ROSSEL — Firestore Security Rules
// ============================================================
// INSTRUCTIONS:
// 1. Go to https://console.firebase.google.com/project/calvier-rossel/firestore/rules
// 2. Replace the existing rules with the content below (inside the service block)
// 3. Click "Publish"
// ============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper Functions ─────────────────────────────────────
    function isLoggedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isLoggedIn() &&
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
         (request.auth.token.email != null &&
          (request.auth.token.email.lower() == 'cavaxioglobals@gmail.com' ||
           request.auth.token.email.lower() == 'ralph.rosellini@gmail.com' ||
           exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())))));
    }

    function isOwner(userId) {
      return isLoggedIn() && request.auth.uid == userId;
    }

    // ── Products ─────────────────────────────────────────────
    // Anyone can read products; only admins can write
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── Collections ──────────────────────────────────────────
    match /collections/{collectionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Categories ───────────────────────────────────────────
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Testimonials ─────────────────────────────────────────
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Site Content (homepage images, banners, etc.) ────────
    match /site_content/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Banners ───────────────────────────────────────────────
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Orders ───────────────────────────────────────────────
    match /orders/{orderId} {
      allow read: if isAdmin() || (isLoggedIn() && resource.data.userId == request.auth.uid);
      allow create: if (isLoggedIn() && request.resource.data.userId == request.auth.uid) || (!isLoggedIn() && request.resource.data.userId == 'guest');
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Users (folder) ────────────────────────────────────────
    // Users can read/write their own profile upon login; admins can read/write all
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    // ── Admins ────────────────────────────────────────────────
    // Anyone logged in can read the admin list (for permissions check)
    // Only authorized admins can add or remove admin emails
    match /admins/{adminId} {
      allow read: if isLoggedIn();
      allow write: if isAdmin();
    }

    // ── OTP Sessions (server-only via Admin SDK) ──────────────────────────────
    match /_otp_sessions/{phone} {
      allow read, write: if false;
    }

  }
}
